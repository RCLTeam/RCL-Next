{
  "name": "rcl",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "scripts": {
    "dev:api": "pnpm build:packages && pnpm --filter @rcl/api dev",
    "dev:web": "pnpm --filter @rcl/contracts build && pnpm --filter @rcl/web dev",
    "db:generate": "pnpm --filter @rcl/database db:generate",
    "db:migrate": "pnpm --filter @rcl/database db:migrate",
    "db:seed": "pnpm --filter @rcl/database db:seed",
    "db:studio": "pnpm --filter @rcl/database db:studio",
    "db:check": "pnpm --filter @rcl/database db:check",
    "db:local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/postgres-local.ps1 start",
    "db:local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/postgres-local.ps1 stop",
    "db:local:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/postgres-local.ps1 status",
    "build": "pnpm -r build",
    "typecheck": "pnpm build:packages && tsc -p tsconfig.json && pnpm -r typecheck",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && biome check . && vitest run",
    "prepare": "simple-git-hooks",
    "build:packages": "pnpm --filter \"./packages/*\" build"
  },
  "devDependencies": {
    "@rcl/contracts": "workspace:*",
    "@biomejs/biome": "^1.9.4",
    "@electric-sql/pglite": "^0.3.14",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.0.7",
    "drizzle-orm": "^0.44.7",
    "simple-git-hooks": "^2.11.1",
    "supertest": "^7.1.4",
    "typescript": "^5.9.2",
    "vitest": "^3.0.7",
    "ws": "^8.21.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm biome check --staged --no-errors-on-unmatched"
  }
}
