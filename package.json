{
  "name": "rcl",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "db:generate": "pnpm --filter @rcl/database db:generate",
    "db:migrate": "pnpm --filter @rcl/database db:migrate",
    "db:studio": "pnpm --filter @rcl/database db:studio",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && biome check . && vitest run",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@vitest/coverage-v8": "^3.0.7",
    "simple-git-hooks": "^2.11.1",
    "vitest": "^3.0.7"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm biome check --staged --no-errors-on-unmatched"
  }
}
