# Local development only; shared by the API and database commands.
DATABASE_URL=postgresql://rcl:rcl_dev_password@localhost:5432/rcl?sslmode=disable
# Directory containing pg_dump and pg_restore; empty uses PATH.
POSTGRES_BIN_DIR=
HOST=127.0.0.1
PORT=3001
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
# Explicitly opt into synthetic fixtures; always disabled in production.
ALLOW_DEMO_SEED=true

# Fill all three to enable Discord OAuth; leaving all blank disables sign-in (503).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Register this exact URL in the Discord Developer Portal (OAuth2 > Redirects):
# http://localhost:3001/api/v1/auth/discord/callback
DISCORD_REDIRECT_URI=

# Persistent directory for editorial uploads (relative to API working directory).
EDITORIAL_IMAGE_DIR=data/editorial-images
# Optional absolute persistent directory for team logos. Defaults to apps/web/public/images/teams_logo.
# TEAM_LOGO_DIR=/persistent/team-logos
# Discord WebSocket Bridge (Suggestions system)
# URL of the LigaBot WebSocket bridge server (e.g., ws://127.0.0.1:8765/ws/bridge or wss://...)
DISCORD_BOT_WS_URL=
# Supertoken secret configured on LigaBot; required for authenticated bridge sessions
DISCORD_BOT_WS_SUPERTOKEN=

# Reverse proxies whose X-Forwarded-For is trusted to resolve the client IP
# (used by the suggestions rate limit). Default: loopback (proxy on the same host).
# Use false without a proxy, a hop count (e.g. 1) or a comma-separated list of
# addresses/subnets (e.g. 10.0.0.0/8). "true" is rejected.
TRUST_PROXY=loopback
